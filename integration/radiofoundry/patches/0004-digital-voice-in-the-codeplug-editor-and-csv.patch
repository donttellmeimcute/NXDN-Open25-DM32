+// P25, NXDN and P25 trunking channels (open-firmware-cps.md 7.3.3.1; the multi-mode derivative)
+test("digital voice channels: record layout, CSV round trip, blank cells keep values", async () => {
+	const { encodeChannel, decodeChannel, blankChannel } = await import("../static/js/codeplug/records.js");
+	const p25 = newChannel({ name: "P25 Ops", rxHz: 155475000, txHz: 155475000, mode: "p25", nacRx: 0xF7E, nacTx: 0x293,
+		talkgroup: 10101, hearAll: true, dmrId: 1234567 });
+	const r = encodeChannel(p25, blankChannel());
+	assert.equal(r[0x18], 2);
+	assert.deepEqual([...r.slice(0x20, 0x24)], [0x7E, 0x0F, 0x93, 0x02]);
+	assert.deepEqual([...r.slice(0x2E, 0x30)], [10101 & 0xFF, 10101 >> 8]);
+	assert.equal(r[0x26] & 0x80, 0x80);
+	assert.equal(r[0x31] & 0x40, 0x40);
+	const back = decodeChannel(r);
+	assert.equal(back.mode, "p25");
+	assert.equal(back.nacRx, 0xF7E);
+	assert.equal(back.nacTx, 0x293);
+	assert.equal(back.talkgroup, 10101);
+	assert.equal(back.contact, 0);
+	const trunk = newChannel({ name: "Site 1", rxHz: 851012500, txHz: 806012500, mode: "p25trunk", wacn: 0xBEE00, sysid: 0x3A5,
+		nacTx: 0x3A5, talkgroup: 2001 });
+	const rt = decodeChannel(encodeChannel(trunk, blankChannel()));
+	assert.equal(rt.mode, "p25trunk");
+	assert.equal(rt.wacn, 0xBEE00);
+	assert.equal(rt.sysid, 0x3A5);
+	const nx = decodeChannel(encodeChannel(newChannel({ name: "NX", mode: "nxdn", nacRx: 0, nacTx: 12, talkgroup: 200 }), blankChannel()));
+	assert.equal(nx.mode, "nxdn");
+	assert.equal(nx.nacTx, 12);
+	assert.equal(nx.talkgroup, 200);
+
+	const m = empty();
+	m.channels.push({ ...p25, number: 1 }, { ...trunk, number: 2 }, newChannel({ name: "FM", number: 3 }));
+	const text = exportTable(m, "channels");
+	const rows = parse(text);
+	const head = rows[0];
+	const col = (row, name) => row[head.indexOf(name)];
+	assert.equal(col(rows[1], "Mode"), "P25");
+	assert.equal(col(rows[1], "RX NAC"), "any");
+	assert.equal(col(rows[1], "TX NAC"), "293");
+	assert.equal(col(rows[1], "Talkgroup"), "10101");
+	assert.equal(col(rows[2], "WACN"), "BEE00");
+	assert.equal(col(rows[2], "System ID"), "3A5");
+	assert.equal(col(rows[3], "RX NAC"), "");	// FM: no P25 values written
+	const n = empty();
+	const res = importTable(n, text);
+	assert.deepEqual(res.problems, []);
+	assert.equal(n.channels[0].nacTx, 0x293);
+	assert.equal(n.channels[0].nacRx, 0xF7E);
+	assert.equal(n.channels[1].wacn, 0xBEE00);
+	// a TX NAC that only receive uses is refused
+	const bad = importTable(empty(), "Name,Mode,RX Frequency (MHz),TX NAC\nX,P25,155.475,F7E\n");
+	assert.equal(bad.problems.length, 1);
+	assert.equal(bad.problems[0].code, "range");
+});
