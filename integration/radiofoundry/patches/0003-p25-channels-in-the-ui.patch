 // The mode word: AM where an FM channel or the VFO is received in AM (the air band)
 static const char *mode_word(const radio_view_t *v)
 {
-	return v->ch.mode == RADIO_MODE_DMR ? "DMR" : v->am ? "AM" : "FM";
+	switch (v->ch.mode) {
+	case RADIO_MODE_DMR: return "DMR";
+	case RADIO_MODE_P25: return "P25";
+	case RADIO_MODE_NXDN: return "NXDN";
+	case RADIO_MODE_P25_TRUNK: return "P25T";
+	default: return v->am ? "AM" : "FM";
+	}
+}
+
+// P25 and NXDN channels (the multi-mode derivative): NACs in hex, IDs in decimal
+static void sb_nac(sbuf_t *b, uint16_t nac)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	for (int s = 8; s >= 0; s -= 4)
+		sb_chr(b, hex[(nac >> s) & 0xFu]);
+}
+
+static bool dv_channel(const radio_view_t *v)
+{
+	return codeplug_mode_digital_voice(v->ch.mode);
+}
+
+// The PTT line: the talkgroup our calls go to
+static void draw_talk_dv(const radio_view_t *v)
+{
+	const ui_layout_t *L = &ui_layout;
+	const font_t *f = L->medium;
+	char buf[40], fit[40];
+	sbuf_t b;
+	sb_init(&b, buf, sizeof buf);
+	color_t c = ui_col.fg;
+	if (!v->dv.active) {
+		sb_str(&b, TR("Digital: not in this build"));
+		c = ui_col.warn;
+	} else if (v->ch.rx_only) {
+		sb_str(&b, TR("RX only"));
+		c = ui_col.warn;
+	} else if (v->ch.talkgroup == 0) {
+		sb_str(&b, TR("No talkgroup"));
+		c = ui_col.warn;
+	} else {
+		sb_str(&b, "TG ");
+		sb_u32(&b, v->ch.talkgroup, 1);
+	}
+	int x = gfx_text(f, 0, L->talk_y, "PTT" GLYPH_ARROW " ", ui_col.dim);
+	gfx_text_fit(f, buf, gfx_width() - x, fit, sizeof fit);
+	gfx_text(f, x, L->talk_y, fit, c);
+}
+
+// Chips: NAC (RX/TX when they differ), power, our unit ID
+static void draw_chips_dv(const radio_view_t *v)
+{
+	const ui_layout_t *L = &ui_layout;
+	const font_t *f = L->small;
+	int w = gfx_width();
+	char buf[48];
+	sbuf_t b;
+	int x = 0, y = L->chips_y;
+	sb_init(&b, buf, sizeof buf);
+	sb_str(&b, v->ch.mode == RADIO_MODE_NXDN ? "RAN " : "NAC ");
+	if (v->ch.mode == RADIO_MODE_NXDN) {
+		sb_u32(&b, v->ch.nac_tx, 1);
+	} else {
+		sb_nac(&b, v->ch.nac_tx);
+		if (v->ch.nac_rx != v->ch.nac_tx) {
+			sb_chr(&b, '/');
+			if (v->ch.nac_rx == CODEPLUG_NAC_ANY)
+				sb_str(&b, TR("any"));
+			else
+				sb_nac(&b, v->ch.nac_rx);
+		}
+	}
+	x = gfx_text(f, x, y, buf, ui_col.fg) + f->w;
+	x = gfx_text(f, x, y, ui_power_name(v->power), ui_col.fg) + f->w;
+	sb_init(&b, buf, sizeof buf);
+	sb_str(&b, "ID ");
+	sb_u32(&b, v->dv.source != 0 && v->state == RS_TX ? v->dv.source : v->ch.dmr_id, 1);
+	if (v->ch.dmr_id != 0 && x + gfx_text_width(f, buf) <= w)
+		gfx_text(f, x, y, buf, ui_col.fg);
+}
+
+// The call heard or sent: "TG 100  ID 1234567", encrypted calls marked (never decrypted)
+static void sb_dv_call(sbuf_t *b, uint16_t tg, uint32_t src)
+{
+	sb_str(b, "TG ");
+	sb_u32(b, tg, 1);
+	if (src != 0) {
+		sb_str(b, "  ID ");
+		sb_u32(b, src, 1);
+	}
 }
 
