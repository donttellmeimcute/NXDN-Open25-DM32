--- a/core/ui/ui_screens.c
+++ b/core/ui/ui_screens.c
@@ -276,6 +276,18 @@
 	if (!v->dv.active) {
 		sb_str(&b, TR("Digital: not in this build"));
 		c = ui_col.warn;
+	} else if (v->ch.mode == RADIO_MODE_P25_TRUNK && v->dv.trunk == RDV_TRUNK_HUNT) {
+		sb_str(&b, TR("Searching for the site"));
+		c = ui_col.warn;
+	} else if (v->ch.mode == RADIO_MODE_P25_TRUNK && v->dv.trunk == RDV_TRUNK_REQUEST) {
+		sb_str(&b, TR("Requesting a channel"));
+	} else if (v->ch.mode == RADIO_MODE_P25_TRUNK && v->dv.trunk == RDV_TRUNK_QUEUED) {
+		sb_str(&b, TR("Queued by the system"));
+		c = ui_col.warn;
+	} else if (v->ch.mode == RADIO_MODE_P25_TRUNK && (!CONFIG_P25_TRUNK_TX || !v->dv.trunk_registered)) {
+		// On the site, listening: trunked transmit off in this build, or the system has not registered us
+		sb_str(&b, !CONFIG_P25_TRUNK_TX ? TR("Listen only") : TR("Not registered"));
+		c = ui_col.dim;
 	} else if (v->ch.rx_only) {
 		sb_str(&b, TR("RX only"));
 		c = ui_col.warn;
