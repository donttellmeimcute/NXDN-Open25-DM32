+// P25, NXDN and P25 trunking channels in the 56-byte record (open-firmware-cps.md 7.3.3.1)
+static void test_digital_voice_records(void)
+{
+	uint8_t rec[CODEPLUG_OPENFW_CHANNEL_SIZE];
+	channel_t ch, back;
+
+	memset(rec, 0xFF, sizeof(rec));	// erased: the encoder starts from a blank record
+	memset(&ch, 0, sizeof(ch));
+	strcpy(ch.name, "P25 Simplex");
+	ch.rx_hz = ch.tx_hz = 155475000;
+	ch.mode = RADIO_MODE_P25;
+	ch.power = 1;
+	ch.nac_rx = CODEPLUG_NAC_ANY;
+	ch.nac_tx = 0x293;
+	ch.talkgroup = 10101;
+	ch.dmr_id = 1234567;
+	ch.hear_all = true;
+	ch.tot_s = 60;
+	codeplug_openfw_encode(&ch, rec);
+	CHECK(rec[0x18] == 2);
+	CHECK(rec[0x20] == 0x7E && rec[0x21] == 0x0F && rec[0x22] == 0x93 && rec[0x23] == 0x02);
+	CHECK(rec[0x2E] == (10101 & 0xFF) && rec[0x2F] == (10101 >> 8));
+	CHECK(rec[0x26] & 0x80);	// the unit ID is the channel's ID override
+	CHECK(rec[0x31] & 0x40);	// hear every talkgroup
+	CHECK(codeplug_openfw_decode(rec, &back));
+	CHECK(back.mode == RADIO_MODE_P25 && back.nac_rx == CODEPLUG_NAC_ANY && back.nac_tx == 0x293);
+	CHECK(back.talkgroup == 10101 && back.dmr_id == 1234567 && back.hear_all && back.tot_s == 60);
+	CHECK(back.contact == 0 && back.rx_tone.type == TONE_NONE && back.tx_tone.type == TONE_NONE);
+	CHECK(strcmp(back.name, "P25 Simplex") == 0 && back.rx_hz == 155475000 && back.power == 1);
+
+	// An FM CPS's blank tone words read as the defaults; a reserved TX NAC is refused
+	rec[0x20] = rec[0x21] = rec[0x22] = rec[0x23] = 0xFF;
+	CHECK(codeplug_openfw_decode(rec, &back));
+	CHECK(back.nac_rx == CODEPLUG_NAC_ANY && back.nac_tx == CODEPLUG_NAC_DEFAULT);
+	rec[0x22] = 0x7F; rec[0x23] = 0x0F;	// F7F
+	CHECK(codeplug_openfw_decode(rec, &back) && back.nac_tx == CODEPLUG_NAC_DEFAULT);
+
+	// NXDN: RANs in the tone words, the group in the contact word
+	memset(rec, 0xFF, sizeof(rec));
+	ch.mode = RADIO_MODE_NXDN;
+	ch.nac_rx = 0;		// every RAN
+	ch.nac_tx = 12;
+	ch.talkgroup = 200;
+	ch.dmr_id = 4001;
+	ch.hear_all = false;
+	codeplug_openfw_encode(&ch, rec);
+	CHECK(rec[0x18] == 3);
+	CHECK(codeplug_openfw_decode(rec, &back));
+	CHECK(back.mode == RADIO_MODE_NXDN && back.nac_rx == 0 && back.nac_tx == 12 && back.talkgroup == 200);
+	CHECK(back.dmr_id == 4001 && !back.hear_all);
+	rec[0x22] = 64;	// out of range for a RAN
+	CHECK(codeplug_openfw_decode(rec, &back) && back.nac_tx == 1);
+
+	// P25 trunking: WACN and system ID share the SFR, color code and APRS bytes
+	memset(rec, 0xFF, sizeof(rec));
+	ch.mode = RADIO_MODE_P25_TRUNK;
+	ch.rx_hz = 851012500;
+	ch.tx_hz = 806012500;
+	ch.wacn = 0xBEE00;
+	ch.sysid = 0x3A5;
+	ch.nac_rx = CODEPLUG_NAC_ANY;
+	ch.nac_tx = 0x3A5;
+	ch.talkgroup = 2001;
+	codeplug_openfw_encode(&ch, rec);
+	CHECK(rec[0x18] == 4 && !(rec[0x26] & 0x02));
+	CHECK(codeplug_openfw_decode(rec, &back));
+	CHECK(back.mode == RADIO_MODE_P25_TRUNK && back.wacn == 0xBEE00 && back.sysid == 0x3A5);
+	CHECK(back.sfr_flag1 == 0 && back.color_code == 0 && back.talkgroup == 2001);
+
+	// Back to FM: the record holds tones again
+	ch.mode = RADIO_MODE_FM;
+	ch.rx_tone = (subtone_t){ TONE_CTCSS, 1000 };
+	ch.tx_tone = (subtone_t){ TONE_NONE, 0 };
+	ch.contact = 0;
+	codeplug_openfw_encode(&ch, rec);
+	CHECK(codeplug_openfw_decode(rec, &back));
+	CHECK(back.mode == RADIO_MODE_FM && back.rx_tone.type == TONE_CTCSS && back.rx_tone.value == 1000);
+	CHECK(back.nac_rx == 0 && back.talkgroup == 0 && back.wacn == 0);
+
+	// A mode this firmware doesn't know reads as FM
+	rec[0x18] = 9;
+	CHECK(codeplug_openfw_decode(rec, &back) && back.mode == RADIO_MODE_FM);
+}
