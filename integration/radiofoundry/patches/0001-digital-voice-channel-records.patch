+// P25 and NXDN channels (open-firmware-cps.md 7.3.3.1): the tone words hold the NACs (RANs), the TX contact word the
+// talkgroup, the timeslot bit "hear every group". A tone word an FM CPS left (0xFFFF, 0) reads as the default
+static void decode_digital(const uint8_t *r, channel_t *out)
+{
+	bool nxdn = out->mode == RADIO_MODE_NXDN;
+	uint16_t rx = le16(&r[CH_RX_TONE]), tx = le16(&r[CH_TX_TONE]);
+	uint16_t max = nxdn ? 63u : 0xFFFu;
+	out->nac_rx = rx <= max ? rx : (nxdn ? 0u : CODEPLUG_NAC_ANY);
+	out->nac_tx = tx <= max && (nxdn || tx < CODEPLUG_NAC_ANY) ? tx : (nxdn ? 1u : CODEPLUG_NAC_DEFAULT);
+	out->talkgroup = out->contact;
+	out->hear_all = (r[CH_FLAG2] & FLAG2_TS2) != 0;
+	out->rx_tone = out->tx_tone = (subtone_t){ TONE_NONE, 0 };
+	out->contact = 0;
+	out->timeslot = 1;
+	out->color_code = 0;
+	if (out->mode == RADIO_MODE_P25_TRUNK) {
+		// WACN 20 bits: SFR A, SFR B, high nibble of the color code byte; system ID 12 bits: low nibble, APRS byte
+		out->wacn = ((uint32_t)r[CH_SFR_A] << 12) | ((uint32_t)r[CH_SFR_B] << 4) | (r[CH_CC] >> 4);
+		out->sysid = (uint16_t)(((r[CH_CC] & 0x0Fu) << 8) | r[CH_APRS]);
+	}
+	out->sfr_flag1 = out->sfr_a = out->sfr_b = 0;
+}
+
+static void encode_digital(const channel_t *ch, uint8_t *r)
+{
+	put16(&r[CH_RX_TONE], ch->nac_rx);
+	put16(&r[CH_TX_TONE], ch->nac_tx);
+	put16(&r[CH_CONTACT], ch->talkgroup);
+	r[CH_FLAG2] = (uint8_t)((r[CH_FLAG2] & ~FLAG2_TS2) | (ch->hear_all ? FLAG2_TS2 : 0));
+	r[CH_CC] = 0;
+	if (ch->mode == RADIO_MODE_P25_TRUNK) {
+		r[CH_SFR_A] = (uint8_t)(ch->wacn >> 12);
+		r[CH_SFR_B] = (uint8_t)(ch->wacn >> 4);
+		r[CH_CC] = (uint8_t)(((ch->wacn & 0x0Fu) << 4) | ((ch->sysid >> 8) & 0x0Fu));
+		r[CH_APRS] = (uint8_t)ch->sysid;
+		r[CH_LFLAG1] &= (uint8_t)~LFLAG1_SFR;	// those bytes are the system now, not an SFR role
+	}
+}
