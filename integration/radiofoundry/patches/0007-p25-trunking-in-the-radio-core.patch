+#if CONFIG_P25_TRUNK
+// P25 trunking channels: the system goes to radio_dv.h; transmit only in a CONFIG_P25_TRUNK_TX build, with the
+// whole identity entered; no busy lockout (the system hands out the channels)
+static void test_p25_trunk_channel(void)
+{
+	setup_codeplug();
+	add(3, "Site 1", 460112500, RADIO_MODE_P25_TRUNK, false, 1);	// UHF: the radio has no 800 MHz
+	chans[3].tx_hz = 465112500;
+	chans[3].nac_rx = 0x293;
+	chans[3].talkgroup = 100;
+	chans[3].wacn = 0xBEE00;
+	chans[3].sysid = 0x3A5;
+	start();
+	memset(&dv, 0, sizeof(dv));
+	uint32_t id = own_dmr_id;
+	own_dmr_id = 1001;
+	req(RREQ_ZONE_POS, 2);
+	run(30);
+	CHECK(sm.view.ch.mode == RADIO_MODE_P25_TRUNK && sm.dv_running && dv.cfg.mode == RADIO_MODE_P25_TRUNK);
+	CHECK(dv.cfg.rx_hz == 460112500 && dv.cfg.tx_hz == 465112500 && dv.cfg.wacn == 0xBEE00 && dv.cfg.sysid == 0x3A5);
+	CHECK(dv.cfg.unit_id == 1001 && dv.cfg.talkgroup == 100);
+
+	// A call the trunking logic followed plays
+	dv_heard(true, true, 100, 5555);
+	run(30);
+	CHECK(sm.view.state == RS_RX && sm.view.dv.source == 5555);
+	dv_quiet();
+	run(30);
+	CHECK(sm.view.state == RS_IDLE);
+
+	// Busy lockout does not apply: another NAC heard on the control channel is the system, not a busy channel
+	sm.set.bcl = RADIO_BCL_CARRIER;
+	dv_heard(false, false, 0, 0);
+	run(30);
+	req(RREQ_PTT, 1);
+#if CONFIG_P25_TRUNK_TX
+	CHECK(sm.view.state == RS_TX && dv.downs == 1);
+	// the system refuses: shown until PTT is released
+	dv_tx_ended(RADIO_DV_TRUNK_REFUSED);
+	run(20);
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_REJECTED);
+	req(RREQ_PTT, 0);
+	run(20);
+	CHECK(sm.view.state != RS_TX_DENIED);
+	// no answer
+	req(RREQ_PTT, 1);
+	CHECK(dv.downs == 2);
+	dv_tx_ended(RADIO_DV_TRUNK_NO_ANSWER);
+	run(20);
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_TIMEOUT);
+	req(RREQ_PTT, 0);
+	run(20);
+	// granted: a call, then its end
+	req(RREQ_PTT, 1);
+	CHECK(sm.view.state == RS_TX && dv.downs == 3);
+	run(500);
+	req(RREQ_PTT, 0);
+	dv_tx_ended(NT_TX_COMPLETE_);
+	run(20);
+	CHECK(sm.view.state == RS_IDLE);
+	// without the system's identity (WACN, System ID): refused before anything is asked
+	chans[3].wacn = 0;
+	req(RREQ_ZONE_POS, 0);
+	run(30);
+	req(RREQ_ZONE_POS, 2);
+	run(30);
+	req(RREQ_PTT, 1);
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_NO_ID && dv.downs == 3);
+	req(RREQ_PTT, 0);
+#else
+	// receive only: PTT never reaches the channel
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_MODE && dv.downs == 0);
+	req(RREQ_PTT, 0);
+#endif
+	sm.set.bcl = RADIO_BCL_OFF;
+	dv_quiet();
+	own_dmr_id = id;
+	req(RREQ_ZONE_POS, 0);
+	run(30);
+	CHECK(!sm.dv_running);
+}
+#endif
