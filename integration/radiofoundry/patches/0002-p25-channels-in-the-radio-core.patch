+#if RADIO_SM_DV
+// ---- P25 channels: a fake native session behind radio_dv.h ----
+#include "p25/radio_dv.h"
+enum { NT_USER_STOP_ = 1, NT_TX_COMPLETE_ = 3, NT_LATE_ = 8, NT_DENIED_ = 14 };	// native_test.h
+static struct {
+	bool selected, refuse;
+	radio_dv_cfg_t cfg;
+	int selects, leaves, downs, ups;
+	radio_dv_status_t st;
+} dv;
+bool radio_dv_select(const radio_dv_cfg_t *c)
+{
+	if (c == NULL) {
+		dv.leaves += dv.selected;
+		dv.selected = false;
+		return true;
+	}
+	if (dv.refuse) {
+		return false;
+	}
+	dv.selected = true;
+	dv.cfg = *c;
+	dv.selects++;
+	return true;
+}
+bool radio_dv_ptt(bool down)
+{
+	if (!dv.selected) {
+		return false;
+	}
+	if (down) {
+		dv.downs++;
+		dv.st.transmitting = true;
+	} else {
+		dv.ups++;
+	}
+	return true;
+}
+void radio_dv_status(radio_dv_status_t *o, uint32_t now_ms)
+{
+	(void)now_ms;
+	*o = dv.st;
+	o->active = dv.selected;
+}
+uint8_t radio_dv_tx_deny(uint8_t r)
+{
+	return r == 0 || r == NT_USER_STOP_ || r == NT_TX_COMPLETE_ ? TXDENY_NONE : r == NT_DENIED_ ? TXDENY_REJECTED : TXDENY_NO_DMR;
+}
+static void dv_tx_ended(uint8_t reason)
+{
+	dv.st.transmitting = false;
+	dv.st.tx_calls++;
+	dv.st.tx_reason = reason;
+}
+static void dv_heard(bool ours, bool playing, uint16_t tg, uint32_t src)
+{
+	dv.st.sync = true;
+	dv.st.sync_ours = ours;
+	dv.st.playing = playing;
+	dv.st.talkgroup = tg;
+	dv.st.source = src;
+	dv.st.nac = ours ? 0x293 : 0x5A5;
+}
+static void dv_quiet(void) { dv.st.sync = dv.st.sync_ours = dv.st.playing = false; }
