+	req(RREQ_PTT, 1);
+	dv.st.transmitting = false;
+	req(RREQ_PTT, 0);
+	run(20);
+	CHECK(sm.view.state == RS_IDLE);
+
+	// Busy channel lockout. CARRIER: any P25 frames. WRONG_TONE ("NAC"): frames of another NAC only
+	sm.set.bcl = RADIO_BCL_CARRIER;
+	dv_heard(true, true, 100, 55);
+	run(30);
+	req(RREQ_PTT, 1);
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_BUSY && dv.downs == 5);
+	req(RREQ_PTT, 0);
+	sm.set.bcl = RADIO_BCL_WRONG_TONE;
+	req(RREQ_PTT, 1);
+	CHECK(sm.view.state == RS_TX && dv.downs == 6);	// our own NAC's call: talk back
+	dv_tx_ended(NT_TX_COMPLETE_);
+	req(RREQ_PTT, 0);
+	run(20);
+	dv_heard(false, false, 0, 0);
+	run(30);
+	req(RREQ_PTT, 1);
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_BUSY && dv.downs == 6);
+	req(RREQ_PTT, 0);
+	dv_quiet();
+	run(30);
+	sm.set.bcl = RADIO_BCL_OFF;
+
+	// No unit ID anywhere, or no talkgroup: refused before the modem is asked
+	uint32_t id = own_dmr_id;
+	own_dmr_id = 0;
+	req(RREQ_PTT, 1);
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_NO_ID && dv.downs == 6);
+	req(RREQ_PTT, 0);
+	own_dmr_id = id;
+
+	// Scan: P25 frames with our NAC stop it; another NAC's do not
+	CHECK(zones[0].count == 5);
+	req(RREQ_ZONE_POS, 0);
+	run(30);
+	CHECK(!sm.dv_running && dv.leaves == 1 && hw.rx_hz == 146520000);	// back on FM: the board tunes again
+	req(RREQ_SCAN, RSCAN_ZONE);
+	bool held = false;
+	for (int i = 0; i < 400 && !held; i++) {
+		run(25);
+		if (sm.dv_running) {
+			dv_heard(true, true, 100, 99);
+		} else {
+			dv_quiet();
+		}
+		held = sm.view.scan_phase == SCAN_PH_HOLD && sm.view.channel_number == 3;
+	}
+	CHECK(held);
+	req(RREQ_SCAN, RSCAN_STOP);
+	run(30);
+	dv_quiet();
+	run(30);
+	req(RREQ_ZONE_POS, 0);
+	run(30);
+	CHECK(!sm.dv_running);
+}
+#endif
+
